<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_monerp" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.monerp</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Évaluation MonErp" name="monerp_purchase_eval">
                    <group>
                        <group string="Qualité &amp; Performance Fournisseur">
                            <field name="monerp_vendor_rating"/>
                            <field name="monerp_sla_score" widget="progressbar"/>
                            <field name="monerp_penalty_amount"/>
                            <field name="monerp_delivery_guarantee"/>
                        </group>
                        <group string="Justification Interne">
                            <field name="monerp_purchase_justification" placeholder="Renseignez le motif de la commande..."/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
