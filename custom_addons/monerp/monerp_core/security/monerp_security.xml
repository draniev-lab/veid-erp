<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- MonErp User Category -->
        <record id="module_category_monerp" model="ir.module.category">
            <field name="name">MonErp</field>
            <field name="description">Gestion des accès et permissions MonErp</field>
            <field name="sequence">10</field>
        </record>

        <!-- MonErp User Group -->
        <record id="group_monerp_user" model="res.groups">
            <field name="name">Utilisateur MonErp</field>
            <field name="category_id" ref="module_category_monerp"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- MonErp Manager Group -->
        <record id="group_monerp_admin" model="res.groups">
            <field name="name">Administrateur MonErp</field>
            <field name="category_id" ref="module_category_monerp"/>
            <field name="implied_ids" eval="[(4, ref('group_monerp_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>


