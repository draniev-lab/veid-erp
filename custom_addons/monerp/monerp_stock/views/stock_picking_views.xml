<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_monerp_qc" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.monerp.qc</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_monerp_pass_qc" string="Valider QC MonErp" type="object" class="btn-success" invisible="monerp_quality_check == 'passed'" groups="monerp_core.group_monerp_user"/>
                <button name="action_monerp_reject_qc" string="Rejeter QC MonErp" type="object" class="btn-danger" invisible="monerp_quality_check == 'rejected'" groups="monerp_core.group_monerp_user"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Logistique &amp; Qualité MonErp" name="monerp_stock_qc">
                    <group>
                        <group string="Contrôle Qualité ISO">
                            <field name="monerp_quality_check" widget="badge" decoration-success="monerp_quality_check == 'passed'" decoration-danger="monerp_quality_check == 'rejected'" decoration-warning="monerp_quality_check == 'pending'"/>
                            <field name="monerp_qc_sample_size"/>
                            <field name="monerp_qc_defect_rate" widget="progressbar"/>
                            <field name="monerp_driver_name"/>
                        </group>
                        <group string="Matrice des Défauts Inspectés">
                            <field name="monerp_qc_critical_defects"/>
                            <field name="monerp_qc_major_defects"/>
                            <field name="monerp_qc_minor_defects"/>
                            <field name="monerp_qc_notes" placeholder="Détails des contrôles effectués..."/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
