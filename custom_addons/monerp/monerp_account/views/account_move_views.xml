<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_monerp" model="ir.ui.view">
        <field name="name">account.move.form.inherit.monerp</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_monerp_approve_invoice" string="Approuver Facture MonErp" type="object" class="btn-success" invisible="monerp_invoice_validation_status == 'approved'" groups="monerp_core.group_monerp_user"/>
                <button name="action_monerp_flag_dispute" string="Signaler Litige MonErp" type="object" class="btn-danger" invisible="monerp_invoice_validation_status == 'disputed'" groups="monerp_core.group_monerp_user"/>
                <button name="action_veid_confirm_momo_payment" string="Confirmer Paiement Mobile Money" type="object" class="btn-primary" invisible="veid_momo_status == 'success' or payment_state in ('paid', 'in_payment')" groups="account.group_account_invoice"/>
                <button name="action_veid_request_approval" string="Demander Visa Hiérarchique" type="object" class="btn-secondary" invisible="veid_approval_state != 'draft' or state != 'draft' or veid_approval_tier == 'none'" groups="account.group_account_invoice"/>
                <button name="action_veid_approve_tier" string="Accorder Visa Hiérarchique" type="object" class="btn-success" invisible="veid_approval_state not in ('pending_daf', 'pending_dg')" groups="account.group_account_manager"/>
                <button name="action_veid_reject_tier" string="Refuser Dépense" type="object" class="btn-danger" invisible="veid_approval_state not in ('pending_daf', 'pending_dg')" groups="account.group_account_manager"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Conformité &amp; Suivi MonErp" name="monerp_account_compliance">
                    <group>
                        <group string="Validation &amp; Rapprochement">
                            <field name="monerp_invoice_validation_status" widget="badge" decoration-success="monerp_invoice_validation_status == 'approved'" decoration-danger="monerp_invoice_validation_status == 'disputed'"/>
                            <field name="monerp_payment_reference_custom"/>
                            <field name="monerp_overdue_days"/>
                            <field name="monerp_late_fee_amount"/>
                        </group>
                        <group string="Paiement Mobile Money VEID">
                            <field name="veid_momo_provider"/>
                            <field name="veid_momo_phone"/>
                            <field name="veid_momo_tx_id"/>
                            <field name="veid_momo_status" widget="badge" decoration-success="veid_momo_status == 'success'" decoration-warning="veid_momo_status == 'pending'" decoration-danger="veid_momo_status == 'failed'"/>
                        </group>
                    </group>
                    <group string="Gouvernance Anti-Fraude &amp; Journal Immuable VEID">
                        <group>
                            <field name="veid_approval_tier"/>
                            <field name="veid_approval_state" widget="badge" decoration-success="veid_approval_state == 'approved'" decoration-warning="veid_approval_state in ('pending_daf', 'pending_dg')" decoration-danger="veid_approval_state == 'rejected'"/>
                        </group>
                        <group>
                            <field name="veid_is_sealed"/>
                            <field name="veid_ledger_block_id"/>
                        </group>
                        <field name="veid_duplicate_warning" invisible="not veid_duplicate_warning" class="text-danger fw-bold"/>
                    </group>
                    <group string="Intelligence Artificielle &amp; Numérisation OCR VEID">
                        <group>
                            <field name="veid_parser_id"/>
                        </group>
                    </group>
                    <group string="Mentions Particulières">
                        <field name="monerp_compliance_notes" placeholder="Notes de conformité réglementaire ou fiscale..."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
