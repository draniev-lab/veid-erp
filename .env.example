# ==============================================================================
# VEID Enterprise - Exemple de Variables d'Environnement (.env.example)
# Copier ce fichier en '.env' et adapter les valeurs pour votre environnement.
# ==============================================================================

# Nom de domaine pour la production (Oracle Cloud) ou localhost en développement
DOMAIN_NAME=erp.veid.com
ADMIN_EMAIL=admin@veid.com

# Ports d'écoute
HTTP_PORT=8069

# Base de Données PostgreSQL
POSTGRES_DB=monerp
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGEME_SECURE_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Master Password Odoo (Gestionnaire de bases de données /web/database/manager)
ADMIN_PASSWD=CHANGEME_MASTER_PASSWORD
